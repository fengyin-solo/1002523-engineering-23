# 本地脚本（scripts/）与部署脚本（docker-compose）共用的唯一配置来源。
# 改端口 / 环境标识 / 种子数据位置，只改这一个文件。
# shellcheck shell=sh

# 运行环境标识：local / staging / prod，后端通过 APP_ENV 读取
APP_ENV=local

# 后端监听地址与端口（docker 部署时表示宿主机映射端口，容器内固定监听 8000）
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# 前端 dev server 地址与端口（docker 部署时表示宿主机映射端口）
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# 熔断器示例数据文件：相对 backend/ 目录解析；本地与镜像内路径一致
FUSE_SEED_FILE=data/fuse.json
