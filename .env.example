# ===== 运行环境 =====
# 本地脚本（scripts/）与 docker-compose 部署统一从本文件读取配置，
# 不要在脚本或 compose 里另写一份端口/地址。需要个性化时用环境变量覆盖：
#   BACKEND_PORT=18000 bash scripts/dev.sh
APP_ENV=local

# ===== 后端 =====
# 本地直连时监听回环；容器内由 docker-compose 覆盖为 0.0.0.0
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# 熔断器示例数据文件，路径相对 backend/ 目录
FUSE_SEED_FILE=data/fuse-seed.json

# ===== 前端 =====
# 本地直连时监听回环；容器内由 docker-compose 覆盖为 0.0.0.0
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# ===== 前端 dev server 代理后端的地址 =====
# 本地直连走回环；容器内部署由 docker-compose 覆盖为 http://backend:8000
VITE_PROXY_TARGET=http://127.0.0.1:8000
